root = true

# Layout matches the ESLint presets (js.configs.recommended +
# @stylistic/recommended): 2-space indent, LF, final newline. Run
# `pnpm run lint --fix` if anything drifts — ESLint is the source of truth.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Generated third-party bundle; formatting is esbuild's.
[vendor/**]
trim_trailing_whitespace = false
insert_final_newline = false
